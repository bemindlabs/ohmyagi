#!/bin/bash
# Runs as root after the files are in place. Opens Terminal with `ohmyagi setup`
# for whoever is logged in at the console. Never fails the install: setup is an
# offer, and `ohmyagi setup` can be typed any time. Set OHMYAGI_NO_SETUP=1 (or
# install from a script with no console user) to skip it.
[ -n "${OHMYAGI_NO_SETUP:-}" ] && exit 0
user="$(stat -f %Su /dev/console 2>/dev/null)"
case "$user" in ""|root|loginwindow) exit 0 ;; esac
uid="$(id -u "$user" 2>/dev/null)" || exit 0
launchctl asuser "$uid" sudo -u "$user" /usr/bin/osascript \
  -e 'tell application "Terminal" to activate' \
  -e 'tell application "Terminal" to do script "/usr/local/bin/ohmyagi setup"' >/dev/null 2>&1 || true
exit 0
